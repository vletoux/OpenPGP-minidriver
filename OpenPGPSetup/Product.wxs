<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?include $(sys.SOURCEFILEDIR)Include.wxi ?>
  <Package Name="OpenPGP Smartcard minidriver" Manufacturer="My Smart Logon" Version="!(bind.FileVersion.openpgpmdrv32dll)"
           UpgradeCode="$(var.UpgradeCode)" InstallerVersion="500" Compressed="yes" Scope="perMachine" Language="1033" Codepage="1252">
    <SummaryInformation Description="OpenPGP Smartcard minidriver" />

    <MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."/>

    <Launch Condition="Privileged" Message="An administrator must approve or install [ProductName]." />

    <?if $(var.Plat) != x86 ?>
    <Launch Condition="VersionNT64" Message="This setup has been design for 64-bit versions of Windows.  Please run the setup on 64-bit Windows or get the 32 bits setup." />
    <?else?>
    <Launch Condition="Not VersionNT64" Message="This setup has been design for 32-bit versions of Windows.  Please run the setup on 32-bit Windows or get the 64 bits setup." />
    <?endif?>

    <!-- do not edit the rtf file with word! The installer will be unable to read the license -->
    <WixVariable Id="WixUILicenseRtf" Value="gnu-lgpl.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="bannrbmp.bmp"/>
    <WixVariable Id="WixUIDialogBmp" Value="dlgbmp.bmp"/>

    <!-- property for add/remove programs -->
    <Property Id="ARPHELPLINK" Value="http://www.mysmartlogon.com" />
    <Property Id="ARPCONTACT" Value="My Smart Logon" />
    <Icon Id="mysmartlogon.ico" SourceFile="mysmartlogon.ico" />
    <Property Id="ARPPRODUCTICON" Value="mysmartlogon.ico" />

    <?if $(var.Plat) != x86 ?>
    <StandardDirectory Id="System64Folder">
      <Component Id="openpgpmdrv64" Guid="2F1B6C0E-5C0B-4C35-9E52-6B1D1D0F7A01">
        <File Id="openpgpmdrv64dll" Name="$(var.NativeDll)" Source="$(var.SourceDir)\$(var.NativeDll)" KeyPath="yes" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Cryptography\Calais\SmartCards\OpenPGP Card v2 (via OpenPGP minidriver)">
          <RegistryValue Type="binary" Name="ATR" Value="3BDA18FF81B1FE751F030031C573C001400090000C"/>
          <RegistryValue Type="binary" Name="ATRMask" Value="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"/>
          <RegistryValue Type="string" Name="Crypto Provider" Value="Microsoft Base Smart Card Crypto Provider"/>
          <RegistryValue Type="string" Name="Smart Card Key Storage Provider" Value="Microsoft Smart Card Key Storage Provider"/>
          <RegistryValue Type="string" Name="80000001" Value="$(var.NativeDll)"/>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Cryptography\Calais\SmartCards\OpenPGP Card v3 (via OpenPGP minidriver)">
          <RegistryValue Type="binary" Name="ATR" Value="3BDA18FF81B1FE751F030031F573C001600090001C"/>
          <RegistryValue Type="binary" Name="ATRMask" Value="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"/>
          <RegistryValue Type="string" Name="Crypto Provider" Value="Microsoft Base Smart Card Crypto Provider"/>
          <RegistryValue Type="string" Name="Smart Card Key Storage Provider" Value="Microsoft Smart Card Key Storage Provider"/>
          <RegistryValue Type="string" Name="80000001" Value="$(var.NativeDll)"/>
        </RegistryKey>
      </Component>
    </StandardDirectory>
    <?endif?>

    <StandardDirectory Id="SystemFolder">
      <Component Id="openpgpmdrv32" Guid="7A9C3E52-1D44-4B6F-8E0A-3C5D2B9F4A02" Bitness="always32">
        <File Id="openpgpmdrv32dll" Name="openpgpmdrv32.dll" Source="$(var.SourceDirAlwaysX86)\openpgpmdrv32.dll" KeyPath="yes" />
        <?if $(var.Plat) != x86 ?>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Wow6432Node\Microsoft\Cryptography\Calais\SmartCards\OpenPGP Card v2 (via OpenPGP minidriver)">
          <RegistryValue Type="binary" Name="ATR" Value="3BDA18FF81B1FE751F030031C573C001400090000C"/>
          <RegistryValue Type="binary" Name="ATRMask" Value="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"/>
          <RegistryValue Type="string" Name="Crypto Provider" Value="Microsoft Base Smart Card Crypto Provider"/>
          <RegistryValue Type="string" Name="Smart Card Key Storage Provider" Value="Microsoft Smart Card Key Storage Provider"/>
          <RegistryValue Type="string" Name="80000001" Value="openpgpmdrv32.dll"/>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Wow6432Node\Microsoft\Cryptography\Calais\SmartCards\OpenPGP Card v3 (via OpenPGP minidriver)">
          <RegistryValue Type="binary" Name="ATR" Value="3BDA18FF81B1FE751F030031F573C001600090001C"/>
          <RegistryValue Type="binary" Name="ATRMask" Value="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"/>
          <RegistryValue Type="string" Name="Crypto Provider" Value="Microsoft Base Smart Card Crypto Provider"/>
          <RegistryValue Type="string" Name="Smart Card Key Storage Provider" Value="Microsoft Smart Card Key Storage Provider"/>
          <RegistryValue Type="string" Name="80000001" Value="openpgpmdrv32.dll"/>
        </RegistryKey>
        <?else?>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Cryptography\Calais\SmartCards\OpenPGP Card v2 (via OpenPGP minidriver)">
          <RegistryValue Type="binary" Name="ATR" Value="3BDA18FF81B1FE751F030031C573C001400090000C"/>
          <RegistryValue Type="binary" Name="ATRMask" Value="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"/>
          <RegistryValue Type="string" Name="Crypto Provider" Value="Microsoft Base Smart Card Crypto Provider"/>
          <RegistryValue Type="string" Name="Smart Card Key Storage Provider" Value="Microsoft Smart Card Key Storage Provider"/>
          <RegistryValue Type="string" Name="80000001" Value="openpgpmdrv32.dll"/>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Cryptography\Calais\SmartCards\OpenPGP Card v3 (via OpenPGP minidriver)">
          <RegistryValue Type="binary" Name="ATR" Value="3BDA18FF81B1FE751F030031F573C001600090001C"/>
          <RegistryValue Type="binary" Name="ATRMask" Value="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"/>
          <RegistryValue Type="string" Name="Crypto Provider" Value="Microsoft Base Smart Card Crypto Provider"/>
          <RegistryValue Type="string" Name="Smart Card Key Storage Provider" Value="Microsoft Smart Card Key Storage Provider"/>
          <RegistryValue Type="string" Name="80000001" Value="openpgpmdrv32.dll"/>
        </RegistryKey>
        <?endif?>
      </Component>
    </StandardDirectory>

    <Feature Id="DefaultFeature" Level="1" Title="OpenPGP Smartcard minidriver" Description="This feature contains the minidriver" AllowAbsent="no" Display="expand">
      <ComponentRef Id="openpgpmdrv32" />
      <?if $(var.Plat) != x86 ?>
      <ComponentRef Id="openpgpmdrv64" />
      <?endif?>
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <MediaTemplate EmbedCab="yes" />
  </Package>
</Wix>
